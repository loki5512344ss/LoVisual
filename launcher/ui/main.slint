import { VerticalBox, LineEdit, Button } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "LoVisual Launcher";
    width: 480px;
    height: 320px;

    in-out property <string> status: "Disconnected";

    VerticalBox {
        spacing: 12px;
        padding: 24px;

        Text {
            text: "LoVisual Launcher";
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
            color: #00bfff;
        }

        Text {
            text: "Войдите в аккаунт, чтобы запустить Minecraft";
            font-size: 13px;
            horizontal-alignment: center;
            color: #9aa0a6;
        }

        VerticalBox {
            spacing: 8px;

            Text { text: "Логин"; }
            LineEdit {
                text <=> login-input;
                placeholder-text: "username or email";
            }

            Text { text: "Пароль"; }
            LineEdit {
                text <=> password-input;
                input-type: InputType.password;
                placeholder-text: "••••••••";
            }
        }

        Button {
            text: "Войти";
            primary: true;
            clicked => root.login();
        }

        Text {
            text: status;
            horizontal-alignment: center;
            color: #ff6b6b;
            font-size: 12px;
        }
    }

    callback login();
    in-out property <string> login-input: "";
    in-out property <string> password-input: "";
}
